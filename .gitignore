.DS_Store
/.build
/Packages
xcuserdata/
DerivedData/
.swiftpm/configuration/registries.json
.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.netrc

# Веса моделей — где бы ни лежали. Правило по РАСШИРЕНИЮ, а не по конкретному
# пути: раньше здесь стоял единственный
# Tests/RWKVGenTests/Resources/world_0.1b_x070.safetensors, каталога с таким
# именем давно нет, и правило годами защищало пустоту.
*.safetensors
*.pth
*.rwkvq
*.rwkvq_mlx.json

# Фикстуры кросс-языкового паритета (см. Scripts/dump_reference.py) —
# десятки мегабайт, генерируются локально по рецептам из NEXT_SESSION.md.
.testdata/

# Прогоны реранкера: кэши состояний на гигабайты и отчёты — локальные.
/runs/

# Tests/ НЕ игнорируется. Пакет, который продаёт себя проверяемостью,
# обязан отдавать проверки вместе с кодом: иначе «418 тестов зелёные» —
# утверждение, которое потребитель не может ни повторить, ни оспорить.
# Крупных фикстур в Tests/ нет (804 КБ, только .swift), веса и .testdata
# отсекаются правилами выше.
#
# Tests/RWKVGenTests/DocExamples.generated.swift КОММИТИТСЯ намеренно, хотя
# и генерируется: в тестовой цели он даёт то, ради чего сделан — примеры из
# docs/*.md компилируются на каждом `swift test`, а не только когда кто-то
# вспомнит запустить Scripts/check_docs.sh. Ценой шума в диффах при правке
# документации.
